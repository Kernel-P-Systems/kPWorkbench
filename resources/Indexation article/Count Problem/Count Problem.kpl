type t1 {
  choice {
	<10c : b1 -> a1 (t2) . 
	<10c : b2 -> a2 (t2) . 
	<10c : b3 -> a3 (t2) . 
	>=10c : b1 -> . 
	>=10c : b2 -> . 
	>=10c : b3 -> . 
	}
}
type t2 {
   choice {
	a1 -> {b1, 1c} (t1) . 
	a2 -> {b2, 2c} (t1) . 
	a3 -> {b3, 3c} (t1) . 
	}
}

c1 {b1, b2, b3} (t1) .
c2 {} (t2) .
c1 - c2 .
