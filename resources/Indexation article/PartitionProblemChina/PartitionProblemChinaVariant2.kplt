#define n = 3, k = 3

type T0 {
}

type T1 {
	max {
		>=t : s -> yes (T0) .
		>=f & <t : s -> no (T0) .
	}
}

type T2 {
	max {
		=b$i$ & !=b$j$ & =x | =b$j$ & !=b$i$ & =x : v$i$, v$j$ -> v . : 1<=i<=n, 1<=j<=n, i<j
	}
	max { x -> $n+1$y, s1 . } : n<=i<=n
	choice { <v$i$ & =s1 : y -> s . : 1<=i<=n }  
	choice { =$k$v  & =s1: y -> s . }  : n<=i<=n 
	choice {
		s1 -> s2 . 
		<y : $n+1$s, s2 -> t (T1) . : n<=i<=n
		>=y : y, s2 -> f (T1) .
	}
}

t0 {} (T0) .
t1 {s} (T1) .

t2_1 {v1, 2v2, 3v3, @b$i$:1<=i<=3@, x} (T2) .
t2_2 {v1, 2v2, 3v3, @b$i$:1<=i<= 2@, x} (T2) .
t2_3 {v1, 2v2, 3v3, b1, b3, x} (T2) .
t2_4 {v1, 2v2, 3v3, b1, x} (T2) .
t2_5 {v1, 2v2, 3v3, @b$i$:2<=i<=3@, x} (T2) .
t2_6 {v1, 2v2, 3v3, b2, x} (T2) .
t2_7 {v1, 2v2, 3v3, b3, x} (T2) .
t2_8 {v1, 2v2, 3v3, x} (T2) .

t0 - t1 - t2_$i$ . : 1<=i<=8