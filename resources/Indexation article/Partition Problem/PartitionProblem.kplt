#define n = 3, k = 3

type T0 {
}

type T1 {
	max {
		>=t : s -> yes (T0) .
		>=f & <t : s -> no (T0) .
	}
}

type T2 {
	max {
		a$i$ -> [b$i$, a$i+1$][a$i+1$] . : 1<=i<n
		a$n$ -> [b$n$, x][x] . : n<=i<=n
	}
	max {
		=b1 & =b2 .. & =bn | =b$j$ & !=b$i$ & =x : v$i$, v$j$ -> v . : 1<=i<=n, 1<=j<=n, i<j
		@&,(=b$i$ | =2c) :0<=i<=2@ | =x : a$i$ -> b$i$ : 1<i<5 
		@|,=b$i$ :0<=i<=n@
		(=b0 | =2c) & (=b1 | =2c) & (=b2 | =2c) | =x : a2 -> b2 .
		(=b0 | =2c) & (=b1 | =2c) & (=b2 | =2c) | =x : a3 -> b3 .
		(=b0 | =2c) & (=b1 | =2c) & (=b2 | =2c) | =x : a4 -> b4 .
	}
	max { x -> $n+1$y, s1 . } : n<=i<=n
	choice { <v$i$ & =s1 : y -> s . }  : 1<=i<=n
	choice { =$k$v  & =s1: y -> s . }  : n<=i<=n
	choice {
		s1 -> s2 . 
		<y : $n+1$s, s2 -> t (T1) . : n<=i<=n
		>=y : y, s2 -> f (T1) .
	}
}

termB {@a_$i$:0<=i<=bits@, b , c } (Term) .
t0 {} (T0) .
t1 {s} (T1) .
t2 {a1, v1, 2v2, 3v3} (T2) .

t0 - t1 - t2 .