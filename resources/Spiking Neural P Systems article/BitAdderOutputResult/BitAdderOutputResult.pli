@model<spiking_psystems>

def main()
{
        call init_topology();
        call init_rules();
}

def init_topology()
{
        @mu = bit1, bit2, xor_gate, and_gate, out_sum, out_carry;

        @ms(bit1) = a;
        @ms(bit2) = a;

        @marcs = (bit1, xor_gate);
        @marcs += (bit1, and_gate);
        
        @marcs += (bit2, xor_gate);
        @marcs += (bit2, and_gate);
        
        @marcs += (xor_gate, out_sum);
        @marcs += (and_gate, out_carry);
}

def init_rules()
{
        [a --> a]'bit1 "a+";
        [a --> a]'bit2 "a+";

        [a*2 --> #]'xor_gate;
        [a --> a]'xor_gate;

        [a*2 --> a]'and_gate;
        [a --> #]'and_gate;
}