ltl: eventually (c1.c >= 1);
ltl: always (c1.c <= 10);
ltl: never (c1.c > 10);
ltl: (c21.a1 > 0) followed-by (c1.b1 > 0);
ltl: (c22.a2 > 0) followed-by (c1.b2 > 0);
ltl: (c23.a3 > 0) followed-by (c1.b3 > 0);
ltl: steady-state (c1.c <= 10);
ltl: infinitely-often (@or, c1.b$i$ > 0 : 1<=i<=3@);
ltl: always ((c1.c >= 10) implies (@and, c2$i$.a$i$ = 0 : 1<=i<=3@));
ltl: always (@and, c1.b$i$ >= 0 : 1<=i<=3@);
ltl: always ((c1.c < 10) or (@and, c2$i$.a$i$ = 0: 1<=i<=3@));
ltl: always (@and, c1.b$i$ >= 0 : 1<=i<=3@);
ltl: eventually ((@+, c1.b$i$ : 1<=i<=3@) > 0);
ltl: always ((@+, c1.b$i$ : 1<=i<=3@) >= 0);
