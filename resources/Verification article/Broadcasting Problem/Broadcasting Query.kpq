ltl: eventually (comp1.c >= 1);
ltl: always (comp1.c <= 10);
ltl: never (comp1.c > 10);
ltl: (c21.a1 > 0) followed-by (comp1.b1 > 0);
ltl: (c22.a2 > 0) followed-by (comp1.b2 > 0);
ltl: (c23.a3 > 0) followed-by (comp1.b3 > 0);
ltl: steady-state (comp1.c <= 10);
ltl: infinitely-often (@or, comp1.b$i$ > 0 : 1<=i<=3@);
ltl: always ((comp1.c >= 10) implies (@and, c2$i$.a$i$ = 0 : 1<=i<=3@));
ltl: always (@and, comp1.b$i$ >= 0 : 1<=i<=3@);
ltl: always ((comp1.c < 10) or (@and, c2$i$.a$i$ = 0: 1<=i<=3@));
ltl: always (@and, comp1.b$i$ >= 0 : 1<=i<=3@);
ltl: eventually ((@+, comp1.b$i$ : 1<=i<=3@) > 0);
ltl: always ((@+, comp1.b$i$ : 1<=i<=3@) >= 0);
