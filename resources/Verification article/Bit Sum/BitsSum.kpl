
type Term {
  max {
    a_0 -> a_0 (Add) . 
    a_1 -> a_1 (Add) . 
    a_2 -> a_2 (Add) . 
    a_3 -> a_3 (Add) . 
  }
}

type Add {
    2a_0 -> a_1 . 
    2a_1 -> a_2 . 
    2a_2 -> a_3 . 
    2a_3 -> a_4 . 
}

termA {a_0, a_1, a_2, a_3} (Term) .

termB {a_0, a_1, a_2, a_3} (Term) .

add {} (Add) .

termA - add .
termB - add .
