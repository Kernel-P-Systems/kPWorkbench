@model<spiking_psystems>

def main()
{
        call init_topology();
        call init_rules();
}

def init_topology()
{
        @mu += {i} : 0 <= i <= 27;

        @ms(0) = a*8;
        @ms(1) = a*5;
        @ms(2) = a;
        @ms(3) = a*3;
        
        @marcs += ({i}, {j}) : 0 <= i <= 1, 4 <= j <= 5;
        @marcs += ({i}, {j}) : 2 <= i <= 3, 6 <= j <= 7;
        
        @marcs += (4, {j}) : 8 <= j <= 9;
        @marcs += (5, 9);
        
        @marcs += (6, {j}) : 10 <= j <= 11;
        @marcs += (7, 10);
        
        @marcs += (8, {j}) : 12 <= j <= 13;
        @marcs += (10, {j}) : 12 <= j <= 13;
        @marcs += (9, {j}) : 14 <= j <= 15;
        @marcs += (11, {j}) : 14 <= j <= 15;

        @marcs += (12, 16);
        @marcs += (12, 18);
        @marcs += (13, 18);
        @marcs += (14, 17);
        @marcs += (14, 19);
        @marcs += (15, 19);

        @marcs += ({i}, {j}) : 16 <= i <= 17, 20 <= j <= 21;
        @marcs += ({i}, {j}) : 18 <= i <= 19, 22 <= j <= 23;

        @marcs += (20, {j}) : 24 <= j <= 25;
        @marcs += (21, 25);

        @marcs += (22, {j}) : 26 <= j <= 27;
        @marcs += (23, 27);
}

def init_rules()
{
        [a --> a]'0 "a+";
        [a --> a]'1 "a+";
        [a --> a]'2 "a+";
        [a --> a]'3 "a+";

        [a*2 --> a]'4;  [a --> #]'4;
        [a*2 --> #]'5;  [a --> a]'5;
        
        [a*2 --> a]'6;  [a --> #]'6;
        [a*2 --> #]'7;  [a --> a]'7;

        [a --> a]'8;
        [a --> a]'9;
        [a --> a]'10;
        [a --> a]'11;

        [a*2 --> a]'12; [a --> #]'12;
        [a*2 --> #]'13; [a --> a]'13;
        
        [a*2 --> a]'14; [a --> #]'14;
        [a*2 --> #]'15; [a --> a]'15;

        [a --> a]'16;
        [a --> a]'17;
        [a --> a]'18;
        [a --> a]'19;

        [a*2 --> a]'20; [a --> #]'20;
        [a*2 --> #]'21; [a --> a]'21;
        
        [a*2 --> a]'22; [a --> #]'22;
        [a*2 --> #]'23; [a --> a]'23;
}